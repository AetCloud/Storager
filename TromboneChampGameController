	private void getScoreAverage()
	{
		float num = notescoreaverage;
		float num2 = Mathf.Clamp(total_length_of_active_notes, 0.2f, 5f) * 8f + 10f;
		float num3 = 0f;
		if (rainbowcontroller.champmode)
		{
			num3 = 1.5f;
		}
		float num4 = Mathf.Floor(num2 * num * (((float)multiplier + num3) * 0.1f + 1f)) * 10f;
		if (num4 < 0f)
		{
			num4 = 0f;
		}
		if (!gameplay_settings.acc_autotoot)
		{
			totalscore += Mathf.FloorToInt(num4);
		}
		else if (gameplay_settings.acc_autotoot)
		{
			totalscore += Mathf.FloorToInt(num4 * 0.5f);
		}
		float healthchange = Mathf.Clamp((num - 79f) * 0.2193f, -15f, 4.34f);
		if (!released_button_between_notes || force_no_gap_gameobject_to_appear)
		{
			healthchange = -15f;
		}
		affectHealthBar(healthchange);
		if (num > 95f)
		{
			doScoreText(4, num);
		}
		else if (num > 88f)
		{
			doScoreText(3, num);
		}
		else if (num > 79f)
		{
			doScoreText(2, num);
		}
		else if (num > 70f)
		{
			doScoreText(1, num);
		}
		else
		{
			doScoreText(0, num);
		}
		notescoreaverage = 0f;
		notescoresamples = 0f;
		notescoretotal = 0f;
		total_length_of_active_notes = 0f;
	}

	private void affectHealthBar(float healthchange)
	{
		if (currenthealth < 100f && currenthealth + healthchange >= 100f)
		{
			maxScoreEffect(entering: true);
			playGoodSound();
		}
		else if (currenthealth >= 100f && currenthealth + healthchange < 100f)
		{
			maxScoreEffect(entering: false);
			currenthealth = 0f;
			sfxrefs.slidedown.Play();
		}
		currenthealth += healthchange;
		if (currenthealth > 100f)
		{
			currenthealth = 100f;
		}
		else if (currenthealth < 0f)
		{
			currenthealth = 0f;
		}
		int num = Mathf.FloorToInt(currenthealth * 0.1f) - champcontroller.healthcounter;
		for (int i = 0; i < Mathf.Abs(num); i++)
		{
			if (num > 0)
			{
				champcontroller.advanceCounter(1);
			}
			else if (num < 0)
			{
				champcontroller.advanceCounter(-1);
			}
		}
	}

