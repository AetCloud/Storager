	private void playFromPlayhead()
	{
		if (!playingineditor)
		{
			float num = Mathf.Abs(noteholderr.anchoredPosition3D.x - zeroxpos);
			bool flag = false;
			for (int num2 = allnotevals.Count - 1; num2 > -1; num2--)
			{
				if (num >= allnotevals[num2][0])
				{
					logMessage("editor starts on note: " + num2);
					currentnoteindex = num2;
					grabNoteRefs(0);
					flag = true;
					break;
				}
			}
			if (!flag)
			{
				logMessage("editor starts on note: 0");
				currentnoteindex = 0;
				grabNoteRefs(0);
			}
			trackmovemult = tempo / 60f * (float)defaultnotelength;
			float time = (noteholderr.anchoredPosition3D.x - zeroxpos) / (0f - (float)trackmovemult);
			musictrack.time = time;
			musictrack.Play();
			float track_time = musictrack.time - latency_offset - noteoffset;
			syncTrackPositions(track_time);
			playingineditor = true;
		}
		else if (playingineditor)
		{
			float num3 = (editorposition = Mathf.Floor((noteholderr.anchoredPosition3D.x - zeroxpos) / (float)(-defaultnotelength)));
			editorpostext.text = "time: " + editorposition;
			playingineditor = false;
			musictrack.Stop();
			LeanTween.moveLocal(noteholder, new Vector3(zeroxpos - num3 * (float)defaultnotelength, 0f, 0f), 0.15f).setEaseInOutQuad();
		}
	}

