	private void tryToLoadLevel(string filename, bool customtrack = false)
	{
		string text = ((!customtrack) ? (SaverLoader.removeFinalBackSlash(GlobalVariables.chosen_track_data.track_folder) + "/trackdata.tmb") : ((GlobalVariables.customtrack_paths != null) ? GlobalVariables.customtrack_paths[0] : (GlobalVariables.chosen_track_data.track_folder + "/song.tmb")));
		if (File.Exists(text))
		{
			if (customtrack)
			{
				SongDataCustom songDataCustom = JsonConvert.DeserializeObject<SongDataCustom>(File.ReadAllText(text));
				SavedLevel savedLevel = new SavedLevel();
				savedLevel.savedleveldata.Clear();
				float[][] notes = songDataCustom.notes;
				foreach (float[] item in notes)
				{
					savedLevel.savedleveldata.Add(item);
				}
				savedLevel.bgdata.Clear();
				if (songDataCustom.bgdata != null && songDataCustom.bgdata.Length != 0)
				{
					notes = songDataCustom.bgdata;
					foreach (float[] item2 in notes)
					{
						savedLevel.bgdata.Add(item2);
					}
				}
				savedLevel.lyricspos.Clear();
				savedLevel.lyricstxt.Clear();
				if (songDataCustom.lyrics != null && songDataCustom.lyrics.Length != 0)
				{
					for (int j = 0; j < songDataCustom.lyrics.Length; j++)
					{
						float[] item3 = new float[2]
						{
							songDataCustom.lyrics[j].bar,
							-165f
						};
						savedLevel.lyricspos.Add(item3);
						savedLevel.lyricstxt.Add(songDataCustom.lyrics[j].text);
					}
				}
				if (songDataCustom.improv_zones != null && songDataCustom.improv_zones.Length != 0)
				{
					for (int k = 0; k < songDataCustom.improv_zones.Length; k++)
					{
						savedLevel.improv_zones.Add(songDataCustom.improv_zones[k]);
					}
				}
				if (songDataCustom.note_color_start == null)
				{
					savedLevel.note_color_start = new float[3] { 0.95f, 0.22f, 0.35f };
					savedLevel.note_color_end = new float[3] { 0.15f, 1f, 1f };
				}
				else
				{
					savedLevel.note_color_start = songDataCustom.note_color_start;
					savedLevel.note_color_end = songDataCustom.note_color_end;
				}
				savedLevel.endpoint = songDataCustom.endpoint;
				savedLevel.tempo = songDataCustom.tempo;
				savedLevel.savednotespacing = songDataCustom.savednotespacing;
				savedLevel.timesig = songDataCustom.timesig;
				bgdata.Clear();
				bgdata = savedLevel.bgdata;
				leveldata.Clear();
				leveldata = savedLevel.savedleveldata;
				lyricdata_pos = savedLevel.lyricspos;
				lyricdata_txt = savedLevel.lyricstxt;
				improv_zones.Clear();
				if (savedLevel.improv_zones != null && savedLevel.improv_zones.Count > 0)
				{
					improv_zones = savedLevel.improv_zones;
				}
				if (savedLevel.note_color_start != null)
				{
					note_c_start = savedLevel.note_color_start;
					note_c_end = savedLevel.note_color_end;
				}
				levelendpoint = savedLevel.endpoint;
				tempo = savedLevel.tempo;
				defaultnotelength = savedLevel.savednotespacing;
				defaultnotelength = Mathf.FloorToInt((float)defaultnotelength * GlobalVariables.gamescrollspeed);
				beatspermeasure = savedLevel.timesig;
				savedLevel = null;
			}
			else if (!customtrack && filename != "EDITOR_MIDI")
			{
				BinaryFormatter binaryFormatter = new BinaryFormatter();
				FileStream fileStream = File.Open(text, FileMode.Open);
				SavedLevel savedLevel2 = (SavedLevel)binaryFormatter.Deserialize(fileStream);
				fileStream.Close();
				fileStream = null;
				bgdata.Clear();
				bgdata = savedLevel2.bgdata;
				leveldata.Clear();
				leveldata = savedLevel2.savedleveldata;
				improv_zones.Clear();
				if (savedLevel2.improv_zones != null && savedLevel2.improv_zones.Count > 0)
				{
					improv_zones = savedLevel2.improv_zones;
				}
				lyricdata_pos = savedLevel2.lyricspos;
				lyricdata_txt = savedLevel2.lyricstxt;
				if (savedLevel2.note_color_start != null)
				{
					note_c_start = savedLevel2.note_color_start;
					note_c_end = savedLevel2.note_color_end;
					if (leveleditor)
					{
						col_r_1.text = note_c_start[0].ToString();
						col_g_1.text = note_c_start[1].ToString();
						col_b_1.text = note_c_start[2].ToString();
						col_r_2.text = note_c_end[0].ToString();
						col_g_2.text = note_c_end[1].ToString();
						col_b_2.text = note_c_end[2].ToString();
					}
				}
				levelendpoint = savedLevel2.endpoint;
				if (leveleditor)
				{
					editorendpostext.text = "end: " + levelendpoint;
				}
				tempo = savedLevel2.tempo;
				defaultnotelength = savedLevel2.savednotespacing;
				defaultnotelength = Mathf.FloorToInt((float)defaultnotelength * GlobalVariables.gamescrollspeed);
				beatspermeasure = savedLevel2.timesig;
				savedLevel2 = null;
			}
			if (leveleditor)
			{
				buildAllBGNodes();
				changeEditorTempo(0);
				changeTimeSig(0);
			}
			buildNotes();
			buildAllLyrics();
			if (improv_zones != null && improv_zones.Count > 0)
			{
				buildImprovZones();
			}
			float num = levelendpoint - (leveldata[leveldata.Count - 1][0] + leveldata[leveldata.Count - 1][1]);
			if (num < 1f)
			{
				levelendpoint += 1f - num;
			}
			levelendtime = 60f / tempo * levelendpoint;
			levelendtime += latency_offset;
			logMessage("Level Loaded!!");
		}
		else
		{
			Debug.LogError("Could not find level data file at: " + text);
		}
	}

