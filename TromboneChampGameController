	private IEnumerator loadCustomAudio()
	{
		string[] array = null;
		string text = string.Empty;
		if (GlobalVariables.customtrack_paths == null)
		{
			array = new string[4]
			{
				GlobalVariables.chosen_track_data.track_folder + "/song.ogg",
				GlobalVariables.chosen_track_data.track_folder + "/song.mp3",
				GlobalVariables.chosen_track_data.track_folder + "/song.wav",
				GlobalVariables.chosen_track_data.track_folder + "/song.aiff"
			};
		}
		else if (GlobalVariables.customtrack_paths[2] != "" && GlobalVariables.customtrack_paths[2] != string.Empty)
		{
			array = new string[1] { GlobalVariables.customtrack_paths[2] };
		}
		string[] array2 = array;
		foreach (string text2 in array2)
		{
			if (File.Exists(text2))
			{
				text = text2;
				break;
			}
		}
		if (text == string.Empty)
		{
			Debug.LogError("Audio filepath string was empty");
			yield break;
		}
		AudioType audioType = AudioType.OGGVORBIS;
		switch (Path.GetExtension(text))
		{
		case ".ogg":
		case ".OGG":
			audioType = AudioType.OGGVORBIS;
			break;
		case ".mp3":
		case ".MP3":
			audioType = AudioType.MPEG;
			break;
		case ".wav":
		case ".WAV":
			audioType = AudioType.WAV;
			break;
		case ".aiff":
		case ".AIFF":
			audioType = AudioType.AIFF;
			break;
		}
		Uri uri = new UriBuilder(Uri.UriSchemeFile, string.Empty)
		{
			Path = text
		}.Uri;
		using UnityWebRequest www = UnityWebRequestMultimedia.GetAudioClip(uri, audioType);
		yield return www.SendWebRequest();
		if (www.error == null)
		{
			while (!www.isDone)
			{
				yield return null;
			}
			AudioClip content = DownloadHandlerAudioClip.GetContent(www);
			musictrack.clip = content;
			musictrack_cliplength = musictrack.clip.length;
			musictrack.volume = 1f * GlobalVariables.localsettings.maxvolume_music;
			if (GlobalVariables.turbomode)
			{
				musictrack.pitch = 2f;
				smooth_scrolling_move_mult = 2f;
			}
			else
			{
				musictrack.pitch = 1f;
			}
		}
	}

