	private void grabNoteRefs(int indexinc)
	{
		if (currentnoteindex + 1 < allnotevals.Count)
		{
			if (Mathf.Abs(leveldata[currentnoteindex + 1][0] - (leveldata[currentnoteindex][0] + leveldata[currentnoteindex][1])) < minimum_note_gap_size)
			{
				if (currentnoteindex > 0 && Mathf.Abs(leveldata[currentnoteindex][0] - (leveldata[currentnoteindex - 1][0] + leveldata[currentnoteindex - 1][1])) > minimum_note_gap_size && !released_button_between_notes && !released_during_timing_window)
				{
					force_no_gap_gameobject_to_appear = true;
				}
				released_button_between_notes = true;
			}
			else
			{
				released_button_between_notes = false;
			}
		}
		currentnoteindex += indexinc;
		if (currentnoteindex > allnotevals.Count - 1)
		{
			currentnotestart = 9999999f;
			currentnoteend = 100000000f;
			return;
		}
		float[] array = allnotevals[currentnoteindex];
		currentnotestart = array[0];
		currentnoteend = array[1];
		currentnotestarty = array[2];
		currentnotepshift = array[3];
		currentnoteendy = array[4];
	}

	private void tallyScore(float deltaTime)
	{
		currentscore += (int)Mathf.Floor(194567f * deltaTime);
		ui_score.text = currentscore.ToString("n0");
		ui_score_shadow.text = currentscore.ToString("n0");
		if (!previous_high_score_surpassed && currentscore > previous_high_score)
		{
			previous_high_score_surpassed = true;
			previous_high_gameobject.SetActive(value: true);
