			{
				startvals[0] = editorposition;
				startvals[1] = pointerrect.transform.localPosition.y;
				enterindex = 1;
			}
			return;
		}
		endvals[0] = editorposition;
		endvals[1] = pointerrect.transform.localPosition.y;
		if (endvals[0] <= startvals[0])
		{
			logMessage("note doesn't move forwards");
			return;
		}
		float[] array = new float[5]
		{
			startvals[0],
			endvals[0] - startvals[0],
			startvals[1],
			endvals[1] - startvals[1],
			endvals[1]
		};
		bool flag = false;
		for (int i = 0; i < leveldata.Count; i++)
		{
			if (leveldata[i][0] > startvals[0])
			{
				logMessage("You inserted a note BEFORE note at index " + i);
				flag = true;
				leveldata.Insert(i, array);
				break;
			}
		}
		if (!flag)
		{
			leveldata.Add(array);
		}
		logMessage("FULL LIST OF STARTING VALUES");
		for (int j = 0; j < leveldata.Count; j++)
		{
			logMessage("-> " + leveldata[j][0]);
		}
		GameObject gameObject = UnityEngine.Object.Instantiate(singlenote, new Vector3(0f, 0f, 0f), Quaternion.identity, noteholder.transform);
		allnotes.Add(gameObject);
		RectTransform component = gameObject.GetComponent<RectTransform>();
		RectTransform component2 = gameObject.transform.GetChild(1).gameObject.GetComponent<RectTransform>();
		_ = gameObject.transform.GetChild(2).gameObject;
		LineRenderer[] componentsInChildren = gameObject.GetComponentsInChildren<LineRenderer>();
		component.anchoredPosition3D = new Vector3(array[0] * (float)defaultnotelength, array[2], 0f);
		component2.anchoredPosition3D = new Vector3((float)defaultnotelength * array[1] - (float)levelnotesize, array[3], 0f);
		float[] item = new float[5]
		{
			array[0] * (float)defaultnotelength,
			array[0] * (float)defaultnotelength + (float)defaultnotelength * array[1],
			array[2],
			array[3],
			array[4]
		};
		allnotevals.Add(item);
		float num = (float)defaultnotelength * array[1];
		float c = array[3];
		LineRenderer[] array2 = componentsInChildren;
		foreach (LineRenderer lineRenderer in array2)
		{
			lineRenderer.SetPosition(0, new Vector3(0f, 0f, 0f));
			for (int l = 1; l < 10; l++)
			{
				lineRenderer.SetPosition(l, new Vector3(num / 9f * (float)l, easeInOutVal(l, 0f, c, 9f), 0f));
			}
		}
		componentsInChildren = null;
		gameObject = null;
		component2 = null;
		enterindex = 0;
	}

