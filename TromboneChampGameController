		if ((GlobalVariables.localsave.cardcollectionstatus[36] >= 10 && GlobalVariables.show_toot_rainbow) || (GlobalVariables.localsave.cardcollectionstatus_gold[36] > 0 && GlobalVariables.show_toot_rainbow))
		{
			puppet_humanc.show_rainbow = true;
		}
		puppet_humanc.setTromboneTex(textureindex);
		topbreathr = topbreath.GetComponent<RectTransform>();
		bottombreathr = bottombreath.GetComponent<RectTransform>();
		noteholderr = noteholder.GetComponent<RectTransform>();
		noteparticlesrect = noteparticles.transform.GetComponent<RectTransform>();
		leftboundsglow.transform.localScale = new Vector3(0.01f, 1f, 1f);
		for (int i = 0; i < 15; i++)
		{
			notelines[i] = notelinesholder.transform.GetChild(i).gameObject;
		}
		for (int j = 0; j < 8; j++)
		{
			GameObject gameObject4 = notelines[j].gameObject;
			float num = vbounds / 12f;
			switch (j)
			{
			case 0:
				gameObject4.transform.localPosition = new Vector3(0f, vbounds, 0f);
				break;
			case 1:
				gameObject4.transform.localPosition = new Vector3(0f, vbounds - num, 0f);
				break;
			case 2:
				gameObject4.transform.localPosition = new Vector3(0f, vbounds - num * 3f, 0f);
				break;
			case 3:
				gameObject4.transform.localPosition = new Vector3(0f, vbounds - num * 5f, 0f);
				break;
			case 4:
