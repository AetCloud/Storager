	private void animateOutNote(int noteindex, int performance)
	{
		noteendeffect noteendeffect2 = allnoteendeffects[noteparticles_index];
		if (!noteendeffect2.noteeffect_obj.activeSelf)
		{
			noteendeffect2.noteeffect_obj.SetActive(value: true);
		}
		LeanTween.cancel(noteendeffect2.burst_obj);
		LeanTween.cancel(noteendeffect2.drops_obj);
		LeanTween.cancel(noteendeffect2.combotext_obj);
		noteendeffect2.noteeffect_rect.anchoredPosition3D = new Vector3(0f, allnotes[noteindex].transform.GetComponent<RectTransform>().anchoredPosition3D.y + allnotes[noteindex].transform.GetChild(1).GetComponent<RectTransform>().anchoredPosition3D.y, 0f);
		noteendeffect2.burst_particles.Stop();
		ParticleSystem.MainModule main = noteendeffect2.burst_particles.main;
		if (performance == 0)
		{
			main.startColor = new Color(1f, 0f, 0f, 0.3f);
		}
		else if (performance > 3)
		{
			ParticleSystem.MinMaxGradient startColor = new ParticleSystem.MinMaxGradient(note_end_rainbow_gradient);
			startColor.mode = ParticleSystemGradientMode.RandomColor;
			main.startColor = startColor;
		}
		else
		{
			main.startColor = new Color(1f, 1f, 1f, 0.3f);
		}
		noteendeffect2.burst_particles.Play();
		noteendeffect2.burst_obj.transform.localScale = new Vector3(0.001f, 0.4f, 1f);
		noteendeffect2.burst_obj.transform.localEulerAngles = new Vector3(0f, 0f, UnityEngine.Random.Range(0f, 359f));
		LeanTween.scale(noteendeffect2.burst_obj, new Vector3(0.96f, 0.96f, 1f), 0.25f).setEaseOutQuart();
		if (performance > 3)
		{
			noteendeffect2.burst_img.sprite = noteparticle_images[1];
			noteendeffect2.burst_canvasg.alpha = 0.95f;
		}
		else
		{
			noteendeffect2.burst_img.sprite = noteparticle_images[0];
			noteendeffect2.burst_canvasg.alpha = 0.5f;
		}
		LeanTween.alphaCanvas(noteendeffect2.burst_canvasg, 0f, 0.28f).setEaseInOutQuad();
		noteendeffect2.drops_obj.transform.localScale = new Vector3(0.1f, 0.1f, 1f);
		noteendeffect2.drops_obj.transform.localEulerAngles = new Vector3(0f, 0f, 0f);
		noteendeffect2.drops_canvasg.alpha = 0.9f;
		LeanTween.rotateZ(noteendeffect2.drops_obj, -5f, 0.3f).setEaseInOutQuad();
		LeanTween.scale(noteendeffect2.drops_obj, new Vector3(0.9f, 0.9f, 1f), 0.2f).setEaseOutQuad();
		LeanTween.alphaCanvas(noteendeffect2.drops_canvasg, 0f, 0.25f).setDelay(0.05f).setEaseInQuad();
		noteendeffect2.combotext_obj.transform.localScale = new Vector3(1f, 1f, 1f);
		LeanTween.scale(noteendeffect2.combotext_obj, new Vector3(0.7f, 0.7f, 1f), 0.5f).setEaseOutQuart();
		if (multiplier > 0)
		{
			noteendeffect2.burst_img.color = new Color(1f, 1f, 1f, 1f);
			noteendeffect2.combotext_txt_shadow.text = highestcombocounter + "<size=13>x</size>";
			noteendeffect2.combotext_txt_front.color = new Color(1f, 1f, 1f, 1f);
			noteendeffect2.combotext_txt_front.text = highestcombocounter + "<size=13>x</size>";
			noteendeffect2.combotext_rect.anchoredPosition3D = new Vector3(15f, 15f, 0f);
			noteendeffect2.combotext_rect.localEulerAngles = new Vector3(0f, 0f, -40f);
			LeanTween.moveLocalY(noteendeffect2.combotext_obj, 45f, 0.5f).setEaseOutQuad();
			LeanTween.rotateZ(noteendeffect2.combotext_obj, -10f, 0.5f).setEaseOutQuart();
		}
		else
		{
			switch (performance)
			{
			case 0:
				noteendeffect2.burst_img.color = new Color(1f, 0f, 0f, 1f);
				noteendeffect2.combotext_txt_shadow.text = "x";
				noteendeffect2.combotext_txt_front.color = new Color(1f, 0f, 0f, 1f);
				noteendeffect2.combotext_txt_front.text = "x";
				break;
			case 1:
				noteendeffect2.burst_img.color = new Color(1f, 1f, 1f, 1f);
				noteendeffect2.combotext_txt_shadow.text = note_end_strings[3];
				noteendeffect2.combotext_txt_front.color = new Color(1f, 1f, 1f, 1f);
				noteendeffect2.combotext_txt_front.text = note_end_strings[3];
				break;
			case 2:
				noteendeffect2.burst_img.color = new Color(1f, 1f, 1f, 1f);
				noteendeffect2.combotext_txt_shadow.text = note_end_strings[2];
				noteendeffect2.combotext_txt_front.color = new Color(1f, 1f, 1f, 1f);
				noteendeffect2.combotext_txt_front.text = note_end_strings[2];
				break;
			}
			noteendeffect2.combotext_rect.anchoredPosition3D = new Vector3(15f, -20f, 0f);
			noteendeffect2.combotext_rect.localEulerAngles = new Vector3(0f, 0f, 40f);
			LeanTween.moveLocalY(noteendeffect2.combotext_obj, -50f, 0.5f).setEaseOutQuad();
			LeanTween.rotateZ(noteendeffect2.combotext_obj, 10f, 0.5f).setEaseOutQuart();
		}
		LeanTween.moveLocalX(noteendeffect2.combotext_obj, 30f, 0.5f).setEaseOutQuart();
		LeanTween.scale(noteendeffect2.combotext_obj, new Vector3(1E-05f, 1E-05f, 0f), 0.2f).setEaseInOutQuart().setDelay(0.51f);
		noteparticles_index++;
		if (noteparticles_index > 14)
		{
			noteparticles_index = 0;
		}
		if (note_objs_to_destroy.Count > 0)
		{
			GameObject final_note_segment = note_objs_to_destroy[note_objs_to_destroy.Count - 1];
			LeanTween.scaleY(final_note_segment, 0.0001f, 0.1f).setEaseOutQuart().setOnComplete((Action)delegate
			{
				final_note_segment.SetActive(value: false);
				final_note_segment = null;
			});
			for (int num = 0; num < note_objs_to_destroy.Count - 1; num++)
			{
				note_objs_to_destroy[num].SetActive(value: false);
			}
		}
		note_objs_to_destroy.Clear();
	}

