	private void buildNotes()
	{
		leveldata.Sort((float[] a, float[] b) => a[0].CompareTo(b[0]));
		for (int num = 0; num < leveldata.Count; num++)
		{
			float[] array = new float[5] { 9999f, 9999f, 9999f, 0f, 9999f };
			if (num > 0)
			{
				array = leveldata[num - 1];
			}
			float[] array2 = leveldata[num];
			bool flag = false;
			if ((double)Mathf.Abs(array[0] + array[1] - array2[0]) < (double)minimum_note_gap_size)
			{
				flag = true;
			}
			bool flag2 = false;
			if (array2[1] <= 0.0625f && tempo > 50f && array2[3] == 0f && !flag)
			{
				flag2 = true;
			}
			if (array2[1] <= 0f)
			{
				array2[1] = 0.015f;
				leveldata[num][1] = 0.015f;
			}
			GameObject gameObject = UnityEngine.Object.Instantiate(singlenote, new Vector3(0f, 0f, 0f), Quaternion.identity, noteholder.transform);
			gameObject.name = "note" + num;
			allnotes.Add(gameObject);
			NoteDesigner component = gameObject.GetComponent<NoteDesigner>();
			if (flag)
			{
				if (!flipscheme)
				{
					flipscheme = true;
				}
				else
				{
					flipscheme = false;
				}
			}
			else
			{
				flipscheme = false;
			}
			if (!GlobalVariables.localsettings.acc_disablesongbgs)
			{
				if (!flipscheme)
				{
					component.setColorScheme(note_c_start[0], note_c_start[1], note_c_start[2], note_c_end[0], note_c_end[1], note_c_end[2]);
				}
				else if (flipscheme)
				{
					component.setColorScheme(note_c_end[0], note_c_end[1], note_c_end[2], note_c_start[0], note_c_start[1], note_c_start[2]);
				}
			}
			else
			{
				component.setColorScheme(0.149f, 1f, 1f, 0.149f, 0.8f, 0.8f);
			}
			component.enabled = false;
			component = null;
			RectTransform component2 = gameObject.GetComponent<RectTransform>();
			GameObject gameObject2 = gameObject.transform.GetChild(0).gameObject;
			if (flag)
			{
				allnotes[num - 1].transform.GetChild(1).gameObject.SetActive(value: false);
				gameObject2.SetActive(value: false);
			}
			else
			{
				gameObject2.SetActive(value: true);
			}
			GameObject gameObject3 = gameObject.transform.GetChild(1).gameObject;
			RectTransform component3 = gameObject3.GetComponent<RectTransform>();
			LineRenderer[] array3 = new LineRenderer[2]
			{
				gameObject.transform.GetChild(2).GetComponent<LineRenderer>(),
				gameObject.transform.GetChild(3).GetComponent<LineRenderer>()
			};
			double num2 = array2[0] * (float)defaultnotelength;
			component2.anchoredPosition3D = new Vector3((float)num2, array2[2], 0f);
			if (flag2)
			{
				gameObject3.SetActive(value: false);
			}
			else
			{
				component3.anchoredPosition3D = new Vector3((float)defaultnotelength * array2[1] - (float)levelnotesize + 11.5f, array2[3], 0f);
			}
			float[] item = new float[5]
			{
				array2[0] * (float)defaultnotelength,
				array2[0] * (float)defaultnotelength + (float)defaultnotelength * array2[1],
				array2[2],
				array2[3],
				array2[4]
			};
			allnotevals.Add(item);
			float num3 = (float)defaultnotelength * array2[1];
			float num4 = array2[3];
			LineRenderer[] array4 = array3;
			foreach (LineRenderer lineRenderer in array4)
			{
				if (!flag2)
				{
					if (num4 == 0f)
					{
						lineRenderer.positionCount = 2;
						lineRenderer.SetPosition(0, new Vector3(-3f, 0f, 0f));
						lineRenderer.SetPosition(1, new Vector3(num3, 0f, 0f));
						continue;
					}
					int num6 = (lineRenderer.positionCount = 16);
					lineRenderer.SetPosition(0, new Vector3(-3f, 0f, 0f));
					for (int num8 = 1; num8 < num6; num8++)
					{
						lineRenderer.SetPosition(num8, new Vector3(num3 / (float)(num6 - 1) * (float)num8, easeInOutVal(num8, 0f, num4, num6 - 1), 0f));
					}
				}
				else if (flag2)
				{
					lineRenderer.enabled = false;
					lineRenderer.gameObject.SetActive(value: false);
				}
			}
			if (num > beatstoshow && !leveleditor)
			{
				gameObject.SetActive(value: false);
			}
			array3 = null;
			gameObject = null;
			component2 = null;
			gameObject2 = null;
			gameObject3 = null;
			component3 = null;
		}
	}

