		int num = 0;
		int num2 = 0;
		if (!gameplay_settings.disable_mouse_tooting)
		{
			if (Input.GetMouseButton(0))
			{
				num2++;
				num++;
			}
			if (Input.GetMouseButton(1))
			{
				num2 += 3;
				num++;
			}
		}
		for (int i = 0; i < toot_keys.Count; i++)
		{
			if (Input.GetKey(toot_keys[i]))
			{
				num2 += toot_keys[i].GetHashCode();
				num++;
			}
		}
		if (num_buttons_held_last_frame > 0 && num > num_buttons_held_last_frame)
		{
			flag = false;
		}
		else if (num_buttons_held_last_frame > 0 && num == num_buttons_held_last_frame && last_input_hash != num2)
		{
			flag = false;
		}
		else if (num > 0)
		{
			flag = true;
		}
		last_input_hash = num2;
		num_buttons_held_last_frame = num;
		if (num > 1 && gameplay_settings.multiple_keys_mute)
		{
			return false;
		}
		if (curtainc.controller_ready_state == 1 && flag && !quitting && !enteringlyrics)
		{
			curtainc.controller_ready_state = 2;
			curtainc.openCurtains();
			startSong(delayed: false);
		}
		return flag;
	}

	private void adjustTrackVolume(float amt)
	{
		musictrack.volume += amt * 0.1f;
		if (musictrack.volume >= 1f)
		{
			musictrack.volume = 1f;
			return;
		}
		if (musictrack.volume <= 0f)
		{
			musictrack.volume = 0f;
			return;
		}
		sfxrefs.click.volume = (musictrack.volume + 1f) * 0.25f;
		sfxrefs.click.Play();
	}

