	private void Start()
	{
		if (devmode)
		{
			Application.targetFrameRate = 60;
			SaverLoader.loadSavedGame();
			SaverLoader.tryToLoadSettings(apply: false);
			SaverLoader.loadLevelData();
			Cursor.visible = true;
			if (track_to_test != "")
			{
				GlobalVariables.chosen_track = track_to_test;
			}
			else
			{
				GlobalVariables.chosen_track = "warmup";
			}
		}
		if (gameplay_settings.show_calibration_screen)
		{
			if (gameplay_settings.mouse_controldirection == 0)
			{
				mouse_rel_pos = 0f;
			}
			else if (gameplay_settings.mouse_controldirection == 1)
			{
				mouse_rel_pos = 1f;
			}
			else if (gameplay_settings.mouse_controldirection == 2)
			{
				mouse_rel_pos = 1f;
			}
			else if (gameplay_settings.mouse_controldirection == 3)
			{
				mouse_rel_pos = 0f;
			}
		}
		GlobalVariables.gameplay_allnotescores.Clear();
		getTootKeys();
		note_end_strings[0] = string_localizer.getLocalizedText("gameplay_score_perfecto");
		note_end_strings[1] = string_localizer.getLocalizedText("gameplay_score_nice");
		note_end_strings[2] = string_localizer.getLocalizedText("gameplay_score_ok");
		note_end_strings[3] = string_localizer.getLocalizedText("gameplay_score_meh");
		note_end_strings[4] = string_localizer.getLocalizedText("gameplay_score_nasty");
		highest_combo_text = string_localizer.getLocalizedText("gameplay_ui_combo");
		latency_offset = gameplay_settings.timing_adjustment * 0.001f;
		custom_level = GlobalVariables.playing_custom_track;
		if (GlobalVariables.turbomode)
		{
			latency_offset *= 2f;
		}
		else if (GlobalVariables.practicemode != 1f)
		{
			latency_offset *= GlobalVariables.practicemode;
			breathmultiplier = GlobalVariables.practicemode;
		}
		if (GlobalVariables.build_target == "mac" && gameplay_settings.mouse_movementmode == 1 && GlobalVariables.scene_destination != "freeplay")
		{
			Cursor.lockState = CursorLockMode.Locked;
		}
		else if (!devmode)
		{
			Cursor.lockState = CursorLockMode.Confined;
		}
		retrying = false;
		musictrack_status = track_status.waiting_to_start;
		notescoreaverage = 0f;
		notescoresamples = 0f;
		notescoretotal = 0f;
		musictrack_timeelapsed = -1.0;
		curtains.SetActive(value: true);
		curtainc = curtains.GetComponent<CurtainController>();
		champ_bloom_gameobject.SetActive(value: false);
		level_finished = false;
		scores_A = 0;
		scores_B = 0;
		scores_C = 0;
		scores_D = 0;
		scores_F = 0;
		if (GlobalVariables.scene_destination == "freeplay")
		{
			freeplay = true;
			currentnotestart = 9999f;
			backbtn.SetActive(value: true);
			champcontroller.hideChampText();
			timeelapsedobj.SetActive(value: false);
			time_bar_full_obj.SetActive(value: false);
		}
		else
		{
			backbtn.SetActive(value: false);
		}
		puppetnum = GlobalVariables.chosen_character;
		textureindex = GlobalVariables.chosen_trombone;
		soundset = GlobalVariables.chosen_soundset;
		popuptextobj.transform.localScale = new Vector3(0f, 0f, 1f);
		multtextobj.transform.localScale = new Vector3(0f, 0f, 1f);
		max_star_gameobject.transform.localScale = new Vector3(0f, 0f, 1f);
		no_gap_gameobject.transform.localScale = new Vector3(0f, 0f, 1f);
		popuptext_rect = popuptextobj.transform.GetComponent<RectTransform>();
		nogap_rect = no_gap_gameobject.transform.GetComponent<RectTransform>();
		BloomModel.Settings settings = gameplayppp.bloom.settings;
		settings.bloom.intensity = 0f;
		gameplayppp.bloom.settings = settings;
		gameplayppp.motionBlur.enabled = GlobalVariables.localsettings.motionblur;
		if (!freeplay && !leveleditor)
		{
			if (!devmode)
			{
				songtitle.text = GlobalVariables.chosen_track_data.trackname_long;
				songtitleshadow.text = GlobalVariables.chosen_track_data.trackname_long;
			}
			else
			{
				songtitle.text = "testing";
				songtitleshadow.text = "testing";
			}
		}
		else if (leveleditor)
		{
			songtitle.text = "LEVEL EDITOR";
			songtitleshadow.text = "LEVEL EDITOR";
		}
		else if (freeplay)
		{
			songtitle.text = "";
			songtitleshadow.text = "";
			ui_score.text = "";
			ui_score_shadow.text = "";
			highestcombo.text = "";
			highestcomboshad.text = "";
		}
		if (!custom_level)
		{
			string text = "";
			if (!freeplay)
			{
				text = SaverLoader.removeFinalBackSlash(GlobalVariables.chosen_track_data.track_folder) + "/contentbundle";
			}
			else if (freeplay)
			{
				text = SaverLoader.getAssetBundlePath("freeplay");
			}
			myLoadedAssetBundle = AssetBundle.LoadFromFile(text);
			if (myLoadedAssetBundle == null)
			{
				logMessage("Failed to load AssetBundle from: " + text);
				return;
			}
			if (!freeplay)
			{
				AudioSource component = myLoadedAssetBundle.LoadAsset<GameObject>("music_" + GlobalVariables.chosen_track).GetComponent<AudioSource>();
				musictrack.clip = component.clip;
				musictrack_cliplength = musictrack.clip.length;
				musictrack.volume = component.volume * GlobalVariables.localsettings.maxvolume_music;
				if (GlobalVariables.turbomode)
				{
					musictrack.pitch = 2f;
					smooth_scrolling_move_mult = 2f;
				}
				else
				{
					musictrack.pitch = 1f;
				}
				component = null;
			}
			StartCoroutine(loadAssetBundleResources());
			if (!freeplay && GlobalVariables.chosen_track_data.is_paid_dlc)
			{
				bgcontroller.songname = "paid_dlc";
			}
			else
			{
				bgcontroller.songname = GlobalVariables.chosen_track;
			}
			GameObject gameObject = null;
			if (!freeplay)
			{
				gameObject = myLoadedAssetBundle.LoadAsset<GameObject>("BGCam_" + GlobalVariables.chosen_track);
			}
			else if (freeplay)
			{
				gameObject = myLoadedAssetBundle.LoadAsset<GameObject>("BGCam_freeplay");
			}
			if (gameObject != null)
			{
				GameObject gameObject2 = UnityEngine.Object.Instantiate(gameObject, new Vector3(0f, 0f, 0f), Quaternion.identity, bgholder.transform);
				gameObject2.transform.localPosition = new Vector3(0f, 0f, 0f);
				bgcontroller.fullbgobject = gameObject2;
			}
			gameObject = null;
		}
		else if (custom_level)
		{
			StartCoroutine(loadCustomAudio());
			GameObject gameObject3 = UnityEngine.Object.Instantiate(custombg_prefab, new Vector3(0f, 0f, 0f), Quaternion.identity, bgholder.transform);
			gameObject3.transform.localPosition = new Vector3(0f, 0f, 0f);
			bgcontroller.songname = "tootmaker_custom";
			bgcontroller.fullbgobject = gameObject3;
			gameObject3 = null;
			StartCoroutine(loadCustomBG());
			StartCoroutine(loadAssetBundleResources());
		}
		string[] array = new string[6] { "default", "bass", "muted", "eightbit", "club", "fart" };
		mySoundAssetBundle = AssetBundle.LoadFromFile(Application.streamingAssetsPath + "/soundpacks/soundpack" + array[soundset]);
		if (mySoundAssetBundle == null)
		{
			logMessage("Failed to load sound pack AssetBundle!");
			return;
		}
		logMessage("LOADED <<<sound pack>>> ASSETBUNDLE");
		UnityEngine.Object.Instantiate(mySoundAssetBundle.LoadAsset<GameObject>("soundpack" + array[soundset]), new Vector3(0f, 0f, 0f), Quaternion.identity, soundSets.transform);
		StartCoroutine(loadSoundBundleResources());
		puppet_human = UnityEngine.Object.Instantiate(playermodels[puppetnum], new Vector3(0f, 0f, 0f), Quaternion.identity, modelparent.transform);
