		{
			LeanTween.scaleY(puppet_human, 1f, 0.5f).setEaseOutBack().setDelay(delay);
		}
	}

	private void calcMaxScore()
	{
		maxlevelscore = 0;
		GlobalVariables.gameplay_absolute_max_score = 0;
		int num = 0;
		float num2 = 0f;
		float num3 = 0f;
		int num4 = 0;
		for (int i = 0; i < leveldata.Count; i++)
		{
			float[] array = leveldata[i];
			bool flag = false;
			if (i + 1 < leveldata.Count && leveldata[i + 1][0] - (array[0] + array[1]) < minimum_note_gap_size)
			{
				flag = true;
			}
			if (flag)
			{
				num2 += array[1];
				continue;
			}
			num2 += array[1];
			float num5 = Mathf.Clamp(num2, 0.2f, 5f);
			num5 = num5 * 8f + 10f;
			float f = Mathf.Floor(num5 * 100f * 1.315f) * 10f;
			maxlevelscore += Mathf.FloorToInt(f);
			if (num4 > 23)
			{
				num3 = 11.5f;
			}
			num += Mathf.FloorToInt(num5 * 100f * (num3 * 0.1f + 1f)) * 10;
			if (num3 < 10f)
			{
				num3 += 1f;
			}
			num2 = 0f;
			num4++;
		}
		logMessage("S-rank score: " + maxlevelscore + " (" + leveldata.Count + " notes)");
		logMessage("absolute max level score: " + num + " (" + leveldata.Count + " notes)");
		GlobalVariables.gameplay_absolute_max_score = num;
	}

