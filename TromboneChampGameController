				break;
			case 6:
				gameObject4.transform.localPosition = new Vector3(0f, vbounds - num * 10f, 0f);
				break;
			case 7:
				gameObject4.transform.localPosition = new Vector3(0f, vbounds - num * 12f, 0f);
				break;
			}
			gameObject4 = null;
		}
		for (int k = 0; k < 7; k++)
		{
			GameObject gameObject5 = notelines[k + 8].gameObject;
			float num2 = vbounds / 12f;
			switch (k)
			{
			case 0:
				gameObject5.transform.localPosition = new Vector3(0f, 0f - num2, 0f);
				break;
			case 1:
				gameObject5.transform.localPosition = new Vector3(0f, num2 * -3f, 0f);
				break;
			case 2:
				gameObject5.transform.localPosition = new Vector3(0f, num2 * -5f, 0f);
				break;
			case 3:
				gameObject5.transform.localPosition = new Vector3(0f, num2 * -7f, 0f);
				break;
			case 4:
				gameObject5.transform.localPosition = new Vector3(0f, num2 * -8f, 0f);
				break;
			case 5:
				gameObject5.transform.localPosition = new Vector3(0f, num2 * -10f, 0f);
				break;
			case 6:
				gameObject5.transform.localPosition = new Vector3(0f, num2 * -12f, 0f);
				break;
